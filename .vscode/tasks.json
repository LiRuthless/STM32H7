{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [ "SmartCar/MDK-GCC/build.sh" ],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "flash",
            "type": "process",
            "command": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [ "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/STM32Flash/flash.ps1" ],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "C:\\Program Files\\Git\\bin\\bash.exe",
            "args": [ "-c", "rm -rf SmartCar/MDK-GCC/build" ],
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        }
    ]
}
